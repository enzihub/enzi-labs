# Copy to .env. All values are optional: docker-compose.yml uses a local Postgres by default.
# Use your own Postgres instead of the bundled one:
DATABASE_URL=
# Credentials for the bundled local Postgres container (defaults: notes / notes / notes)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Flask secret (a random one is generated at start if empty)
SECRET_KEY=
# Host port for the load balancer
LB_PORT=
